diff --git a/arch/arm64/configs/tissot_defconfig b/arch/arm64/configs/tissot_defconfig
index 21e1424..f1c2626 100644
--- a/arch/arm64/configs/tissot_defconfig
+++ b/arch/arm64/configs/tissot_defconfig
@@ -234,15 +234,19 @@ CONFIG_SLUB_CPU_PARTIAL=y
 CONFIG_SYSTEM_DATA_VERIFICATION=y
 CONFIG_PROFILING=y
 CONFIG_TRACEPOINTS=y
-CONFIG_KPROBES=y
+# CONFIG_KPROBES is not set
 CONFIG_JUMP_LABEL=y
+
+# KernelSU (manual hook - KPROBES disabled to avoid the Safe Mode
+# volume-down false-trigger noted in KernelSU's non-GKI integration guide)
